# =============================================================================
# ConnectCG Backend (Spring Boot 3.2 / Java 17) - Production Environment
# File mẫu cấu hình toàn diện cho triển khai Production (VPS / Cloud / Docker Compose)
# Dùng chung với compose.prod.yml hoặc script ./deploy.sh
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DOCKER & CONTAINER RUNTIME
# -----------------------------------------------------------------------------
# Chế độ database: 'managed' (NeonDB / Supabase / AWS RDS) hoặc 'local' (PostgreSQL Docker)
DB_MODE='managed'

# Image backend đăng ký trên GHCR hoặc Docker Hub
BACKEND_IMAGE='ghcr.io/khanhnkq/connectcg-backend'
BACKEND_TAG='latest'

# Địa chỉ IP bind trên VPS (127.0.0.1 để bảo vệ phía sau Reverse Proxy/Cloudflare Tunnel)
SERVICE_BIND_ADDRESS='127.0.0.1'
BACKEND_PORT='8080'

# Cấu hình tối ưu JVM Heap cho máy chủ RAM khiêm tốn (ví dụ: VM 1GB RAM)
JAVA_TOOL_OPTIONS='-Xms192m -Xmx384m -XX:+UseSerialGC'

# URL Health Check dùng cho monitoring / deploy script
HEALTHCHECK_URL='http://127.0.0.1:8080/api/v1/health/readiness'

# -----------------------------------------------------------------------------
# 2. FRONTEND, DOMAINS & CORS / WEBSOCKET
# -----------------------------------------------------------------------------
# URL Production của Frontend (HTTPS)
FRONTEND_URL='https://connect.quizken.com'

# Danh sách allowed origins cho STOMP WebSocket SockJS (phân cách bằng dấu phẩy)
WEBSOCKET_ALLOWED_ORIGINS='https://connect.quizken.com,https://connect-api.quizken.com'

# URL và tên hệ thống dùng cho thông báo, AI context và SEO
SITE_URL='https://connect.quizken.com'
SITE_NAME='ConnectCG'

# -----------------------------------------------------------------------------
# 3. DATABASE (NEONDB SERVERLESS POSTGRESQL / RDS)
# -----------------------------------------------------------------------------
# JDBC Connection URL:
# - NeonDB Pooling: jdbc:postgresql://ep-xxx-pooler.c-4.ap-southeast-1.aws.neon.tech/connect?sslmode=require&channel_binding=require
# - Local Docker: jdbc:postgresql://postgres:5432/connect_db
DB_URL='jdbc:postgresql://ep-sample-pooler.region.aws.neon.tech/connect?sslmode=require&channel_binding=require'
DB_NAME='connect'
DB_USERNAME='neondb_owner'
DB_PASSWORD='replace-with-your-neon-or-db-password'
DB_SCHEMA='public'

# -----------------------------------------------------------------------------
# 4. REDIS (RATE LIMITING, SESSION & CACHE)
# -----------------------------------------------------------------------------
# Mật khẩu xác thực Redis nội bộ giữa các container
REDIS_PASSWORD='replace-with-strong-redis-password'

# Bật/tắt Rate Limiting (chống DDoS / spam API)
RATE_LIMIT_ENABLED='true'

# -----------------------------------------------------------------------------
# 5. RABBITMQ (MESSAGE BROKER CHO ASYNC QUEUE JOBS)
# -----------------------------------------------------------------------------
RABBITMQ_USERNAME='connect_rabbit'
RABBITMQ_PASSWORD='replace-with-strong-rabbitmq-password'
RABBITMQ_PORT='5672'
RABBITMQ_UI_PORT='15672'

# -----------------------------------------------------------------------------
# 6. OBJECT STORAGE (MINIO / S3 - LƯU TRỮ MEDIA VÀ AVATAR)
# -----------------------------------------------------------------------------
# URL công khai truy cập Media (qua Cloudflare Tunnel hoặc Backend Proxy)
MINIO_PUBLIC_URL='https://connect-media.quizken.com'
MINIO_ACCESS_KEY='connect-minio'
MINIO_SECRET_KEY='replace-with-strong-minio-secret-key'
MINIO_BUCKET='connect-media'
MINIO_REGION='garage'
MINIO_API_PORT='9000'
MINIO_CONSOLE_PORT='9001'

# -----------------------------------------------------------------------------
# 7. SECURITY, JWT & COOKIES
# -----------------------------------------------------------------------------
# Khóa bí mật HMAC-SHA256 (tối thiểu 64 hex characters / 256 bits)
JWT_SECRET='replace-with-at-least-64-random-hex-characters'
JWT_EXPIRATION='900000'
REFRESH_TOKEN_LIFETIME='30d'

# Bắt buộc bật Secure cookie trên Production HTTPS
AUTH_COOKIE_SECURE='true'

# SameSite: 'Lax' khi FE và BE cùng root domain (ví dụ connect.quizken.com và connect-api.quizken.com)
#           'None' nếu FE và BE khác root domain hoàn toàn
AUTH_COOKIE_SAME_SITE='Lax'

# Tài khoản demo (luôn tắt trên production)
DEMO_ACCOUNTS_ENABLED='false'
DEMO_ACCOUNTS_PASSWORD=''

# -----------------------------------------------------------------------------
# 8. EMAIL SERVICE (GOOGLE GMAIL SMTP / SENDGRID / AMAZON SES)
# -----------------------------------------------------------------------------
MAIL_HOST='smtp.gmail.com'
MAIL_PORT='587'
MAIL_USERNAME='your-email@gmail.com'
MAIL_PASSWORD='your-gmail-app-password'
MAIL_SMTP_AUTH='true'
MAIL_SMTP_STARTTLS='true'
MAIL_FROM_EMAIL='your-email@gmail.com'
MAIL_FROM_NAME='Connect App'

# -----------------------------------------------------------------------------
# 9. AI SERVICES (GOOGLE GEMINI & OPENROUTER - KIỂM DUYỆT TỰ ĐỘNG)
# -----------------------------------------------------------------------------
# Hệ thống kiểm duyệt bài viết tự động qua RabbitMQ queue (ai.moderation.queue):
# - Mặc định (@Primary): GeminiAiServiceImpl gọi Google Gemini API
# - Dự phòng: OpenRouterServiceImpl gọi model miễn phí qua OpenRouter
# - Caching: Lưu kết quả phân loại vào Redis để tránh gọi lặp lại API tốn quota
GEMINI_API_KEY=''
GEMINI_MODEL='gemini-1.5-flash'
OPENROUTER_API_KEY=''

# -----------------------------------------------------------------------------
# 10. OAUTH 2.0 SOCIAL LOGIN
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID='replace-with-google-client-id.apps.googleusercontent.com'
GOOGLE_CLIENT_SECRET='replace-with-google-client-secret'
FACEBOOK_CLIENT_ID='dummy-facebook-client-id'
FACEBOOK_CLIENT_SECRET='dummy-facebook-client-secret'

# -----------------------------------------------------------------------------
# 11. FIREBASE ARCHITECTURE NOTE (REALTIME CHAT)
# -----------------------------------------------------------------------------
# Kiến trúc Realtime Chat kết hợp Backend Spring Boot & Firebase Realtime Database:
# - Backend: Quản lý khóa phòng `firebase_room_key` trong database và điều phối
#   trạng thái typing / đã đọc (seen) qua WebSocket STOMP.
# - Frontend: Kết nối trực tiếp đến Firebase Realtime DB qua cấu hình
#   VITE_FIREBASE_* (định nghĩa tại connectCG/.env) để push và subscribe tin nhắn.

