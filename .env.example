# =============================================================================
# CẤU HÌNH CHO BACKEND SPRING BOOT (connectCG.)
# =============================================================================

PORT=8080
POSTGRES_PORT=5432
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

DB_NAME=connect_db
DB_USER=connect_user
DB_PASSWORD=connect_password

# Redis chỉ chạy trong Docker network, không mở cổng ra host.
REDIS_PASSWORD=connect_redis_password
REDIS_CONNECT_TIMEOUT=500ms
REDIS_COMMAND_TIMEOUT=500ms
RATE_LIMIT_ENABLED=true
APP_ENV=local

FRONTEND_URL=http://localhost:5173
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5173
SITE_NAME=ConnectCG

JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=900000
REFRESH_TOKEN_LIFETIME=30d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
DEMO_ACCOUNTS_ENABLED=false
DEMO_ACCOUNTS_PASSWORD=

# =============================================================================
# Cấu hình Mail Service (Mailpit Local)
# =============================================================================
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM_EMAIL=noreply@connect.com
MAIL_FROM_NAME=Connect App

# =============================================================================
# Cấu hình Google Gemini AI Content Moderation
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_PROMPT_VERSION=v1
AI_MODERATION_CACHE_ENABLED=true
AI_MODERATION_SAFE_TTL=24h
AI_MODERATION_TOXIC_TTL=7d
HOBBY_CACHE_ENABLED=true
HOBBY_CACHE_TTL=6h
PUBLIC_PROFILE_CACHE_ENABLED=true
PUBLIC_PROFILE_CACHE_TTL=5m

OPENROUTER_API_KEY=

GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
FACEBOOK_CLIENT_ID=dummy-facebook-client-id
FACEBOOK_CLIENT_SECRET=dummy-facebook-client-secret
