# =============================================================================
# ConnectCG Backend (Spring Boot 3.2 / Java 17) - Environment Configuration
# File mẫu cấu hình toàn diện cho môi trường Local Development & Docker Compose
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVER & RUNTIME CORE
# -----------------------------------------------------------------------------
PORT=8080
SERVER_PORT=8080
APP_ENV=local
APP_ENVIRONMENT=local

# -----------------------------------------------------------------------------
# 2. FRONTEND, DOMAINS & CORS / WEBSOCKET
# -----------------------------------------------------------------------------
# URL Frontend nhận điều hướng và cho phép gọi CORS
FRONTEND_URL=http://localhost:5173

# Danh sách allowed origins cho STOMP WebSocket SockJS (phân cách bằng dấu phẩy)
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# URL và tên site hiển thị cho AI Context / OpenRouter / Metadata
SITE_URL=http://localhost:5173
SITE_NAME=ConnectCG

# -----------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL / NEONDB / SUPABASE)
# -----------------------------------------------------------------------------
# Cổng PostgreSQL khi chạy qua docker-compose
POSTGRES_PORT=5432
DB_NAME=connect_db
POSTGRES_DB=connect_db

# Tên người dùng database (hỗ trợ cả DB_USER và DB_USERNAME)
DB_USER=connect_user
DB_USERNAME=connect_user
POSTGRES_USER=connect_user

# Mật khẩu database (hỗ trợ cả DB_PASSWORD và DATABASE_PASSWORD)
DB_PASSWORD=connect_password
DATABASE_PASSWORD=connect_password

# Schema database (mặc định: public)
DB_SCHEMA=public
DATABASE_SCHEMA=public

# URL kết nối JDBC:
# - Chạy Docker Compose local: jdbc:postgresql://postgres:5432/connect_db
# - Chạy localhost trực tiếp: jdbc:postgresql://localhost:5432/connect_db
# - NeonDB Serverless: jdbc:postgresql://ep-xxx-pooler.region.aws.neon.tech/connect?sslmode=require&channel_binding=require
DB_URL=jdbc:postgresql://localhost:5432/connect_db
DATABASE_URL=jdbc:postgresql://localhost:5432/connect_db

# Flyway Migration scripts locations
SPRING_FLYWAY_LOCATIONS=classpath:db/postgresql,classpath:db/postgresql-dev

# -----------------------------------------------------------------------------
# 4. REDIS / VALKEY (CACHING, RATE LIMITING & TOKEN BLACKLIST)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
VALKEY_HOST=localhost
REDIS_PORT=6379
VALKEY_PORT=6379
REDIS_PASSWORD=connect_redis_password
VALKEY_PASSWORD=connect_redis_password
REDIS_CONNECT_TIMEOUT=500ms
REDIS_COMMAND_TIMEOUT=500ms

# Bật/tắt Rate Limiting (Bucket4j qua Redis)
RATE_LIMIT_ENABLED=true

# Cache kiểm duyệt AI nội dung bài viết/bình luận
AI_MODERATION_CACHE_ENABLED=true
AI_MODERATION_SAFE_TTL=24h
AI_MODERATION_TOXIC_TTL=7d

# Cache danh mục sở thích (Hobbies)
HOBBY_CACHE_ENABLED=true
HOBBY_CACHE_TTL=6h

# Cache thông tin cá nhân công khai (Public User Profile)
PUBLIC_PROFILE_CACHE_ENABLED=true
PUBLIC_PROFILE_CACHE_TTL=5m

# -----------------------------------------------------------------------------
# 5. RABBITMQ (MESSAGE BROKER CHO ASYNC QUEUE JOBS)
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_USERNAME=connect_admin
RABBITMQ_PASSWORD=connect_rabbit_password
RABBITMQ_VHOST=/
RABBITMQ_AUTO_STARTUP=true
APP_QUEUE_ENABLED=true

# -----------------------------------------------------------------------------
# 6. OBJECT STORAGE (MINIO / GARAGE S3 / AWS S3 - MEDIA UPLOAD)
# -----------------------------------------------------------------------------
# Endpoint nội bộ Backend gọi tới S3 Service
MINIO_ENDPOINT=http://localhost:3900
STORAGE_S3_ENDPOINT=http://localhost:3900
GARAGE_S3_ENDPOINT=http://localhost:3900

# URL công khai để Client / Frontend xem file media
MINIO_PUBLIC_URL=http://localhost:8080/api/v1/media/view
STORAGE_S3_PUBLIC_URL=http://localhost:8080/api/v1/media/view
GARAGE_S3_PUBLIC_URL=http://localhost:8080/api/v1/media/view

# Thông tin tài khoản MinIO / Garage (Local default: minioadmin / minioadmin123)
MINIO_ACCESS_KEY=minioadmin
STORAGE_S3_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
STORAGE_S3_SECRET_KEY=minioadmin123

MINIO_BUCKET=connect-media
STORAGE_S3_BUCKET=connect-media
MINIO_REGION=garage
STORAGE_S3_REGION=garage

# Cấu hình Background Task dọn dẹp file media rác mồ côi
MEDIA_CLEANUP_TTL_HOURS=24
MEDIA_CLEANUP_BATCH_SIZE=100
MEDIA_CLEANUP_CRON=0 30 3 * * *

# -----------------------------------------------------------------------------
# 7. SECURITY, JWT AUTHENTICATION & COOKIES
# -----------------------------------------------------------------------------
# JWT Secret Key (HMAC-SHA256, tối thiểu 256-bit / 32 bytes hex)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=900000
REFRESH_TOKEN_LIFETIME=30d

# Tên cookie lưu JWT session
ACCESS_COOKIE_NAME=connect_access
REFRESH_COOKIE_NAME=connect_refresh

# Cờ Secure (bật true khi chạy HTTPS, false cho local HTTP)
AUTH_COOKIE_SECURE=false

# SameSite cookie policy (Lax cho cùng root domain, None cho cross-domain với HTTPS)
AUTH_COOKIE_SAME_SITE=Lax

# Tài khoản trải nghiệm demo
DEMO_ACCOUNTS_ENABLED=false
DEMO_ACCOUNTS_PASSWORD=

# -----------------------------------------------------------------------------
# 8. MAIL SERVICE (LOCAL MAILPIT HOẶC GOOGLE GMAIL SMTP)
# -----------------------------------------------------------------------------
# Cổng Mailpit local trong docker-compose
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# Cấu hình SMTP:
# Local Mailpit: MAIL_HOST=localhost, MAIL_PORT=1025, SMTP_AUTH=false, SMTP_STARTTLS=false
# Gmail SMTP: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, SMTP_AUTH=true, SMTP_STARTTLS=true
MAIL_HOST=localhost
SMTP_HOST=localhost
MAIL_PORT=1025
SMTP_PORT=1025
MAIL_USERNAME=
SMTP_USERNAME=
MAIL_PASSWORD=
SMTP_PASSWORD=
MAIL_SMTP_AUTH=false
SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
SMTP_STARTTLS=false
MAIL_FROM_EMAIL=noreply@connect.com
SMTP_FROM_EMAIL=noreply@connect.com
MAIL_FROM_NAME=Connect App
SMTP_FROM_NAME=Connect App

# -----------------------------------------------------------------------------
# 9. AI SERVICES (GOOGLE GEMINI & OPENROUTER FALLBACK - KIỂM DUYỆT TỰ ĐỘNG)
# -----------------------------------------------------------------------------
# Hệ thống kiểm duyệt bài viết tự động qua RabbitMQ queue (ai.moderation.queue):
# - Mặc định (@Primary): GeminiAiServiceImpl gọi Google Gemini API
# - Dự phòng: OpenRouterServiceImpl gọi model miễn phí qua OpenRouter
# - Caching: Lưu kết quả phân loại vào Redis để tránh gọi lặp lại API tốn quota

# Google Gemini API Key (Lấy tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_PROMPT_VERSION=v1

# OpenRouter AI (Dự phòng khi Gemini hết quota hoặc lỗi)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stepfun/step-3.5-flash:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# -----------------------------------------------------------------------------
# 10. OAUTH 2.0 SOCIAL LOGIN
# -----------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_OAUTH_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
GOOGLE_OAUTH_CLIENT_SECRET=dummy-google-client-secret

# Facebook OAuth 2.0 Credentials (https://developers.facebook.com)
FACEBOOK_CLIENT_ID=dummy-facebook-client-id
FACEBOOK_OAUTH_CLIENT_ID=dummy-facebook-client-id
FACEBOOK_CLIENT_SECRET=dummy-facebook-client-secret
FACEBOOK_OAUTH_CLIENT_SECRET=dummy-facebook-client-secret

# -----------------------------------------------------------------------------
# 11. FIREBASE ARCHITECTURE NOTE (REALTIME CHAT)
# -----------------------------------------------------------------------------
# Kiến trúc Realtime Chat kết hợp Backend Spring Boot & Firebase Realtime Database:
# - Backend: Sinh UUID `firebase_room_key` lưu tại bảng `chat_rooms`, xác thực
#   quyền truy cập người dùng và điều phối sự kiện typing/seen qua WebSocket STOMP.
# - Frontend: Kết nối trực tiếp đến Firebase Realtime DB qua các biến môi trường
#   VITE_FIREBASE_* (định nghĩa tại connectCG/.env) để lưu/nhận tin nhắn realtime.

